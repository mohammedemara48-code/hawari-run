{
  "name": "hawari-run",
  "version": "1.1.0",
  "description": "بلبل في الحواري — لعبة منصات مصرية أصلية",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "check": "tsc --noEmit && npm run lint && prettier --check . && npm test && vite build",
    "test:browser": "node tests/smoke.mjs && node tests/runtime.mjs && node tests/bonus.mjs && node tests/mobile.mjs",
    "test:routes": "node tests/traverse.mjs",
    "test:offline": "node tests/offline.mjs",
    "test:hero": "node tests/hero-runtime.mjs",
    "shots:hero": "node tests/hero-shots.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "private": true
}
